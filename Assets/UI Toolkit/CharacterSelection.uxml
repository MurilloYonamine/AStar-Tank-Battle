<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CharacterSelection.uss" />
    <ui:VisualElement name="GameInfoScreen" class="game-info-screen" style="display: none;">
        <ui:VisualElement class="game-info-card">
            <ui:Label text="ANTES DE JOGAR" class="selection-title battle-ui-title" />
            <ui:ScrollView class="game-info-scroll">
                <ui:Label text="COMO JOGAR" class="game-info-heading" />
                <ui:Label text="Movimente o tanque com W, A, S, D ou as setas. Ajuste a mira com Q e E. Atire com espaço ou botão esquerdo do mouse. Use ESC para pausar. Use SHIFT quando a Unique Skill estiver pronta; ela carrega com o tempo e com eliminações. Cada personagem tem sua classe e habilidade; confira os detalhes na seleção. As aparências da mesma personagem compartilham a classe. Os inimigos usam atributos e passivas, mas não ativam Unique Skills." class="game-info-text" />
                <ui:Label text="Elimine 10 inimigos antes dos 3 minutos para vencer. Seu tempo de conclusão é sua marca: quanto menor, melhor. Apenas vitórias entram no ranking, que guarda o melhor tempo de cada jogador; tempos iguais compartilham a posição. Se o tempo acabar enquanto você ainda estiver vivo, a partida termina em empate. Se sua vida chegar a zero antes de concluir o objetivo, você perde. Acompanhe o tempo restante e as eliminações na HUD; a pausa e a contagem inicial não entram no tempo da partida." class="game-info-text" />
                <ui:Label text="DADOS DA PARTIDA" class="game-info-heading" />
                <ui:Label text="Coletamos a identificação do jogador, horários de início e término, duração em segundos, resultado e número de inimigos eliminados. Esses dados são usados para histórico e análise do gameplay. Nas vitórias, a duração é o tempo de conclusão usado para comparar os melhores resultados no ranking." class="game-info-text" />
                <ui:Label text="Os dados são enviados à API PHP e armazenados no MySQL configurado para este projeto (XAMPP nesta instalação) por tempo indeterminado. O token usado para autenticação expira após um dia." class="game-info-text" />
            </ui:ScrollView>
            <ui:VisualElement class="selection-actions game-info-actions">
                <ui:Button name="GameInfoBackButton" text="VOLTAR AO MENU" class="selection-button game-info-button battle-ui-button battle-ui-back" />
                <ui:Button name="GameInfoContinueButton" text="LI E CONTINUAR" class="selection-button game-info-button battle-ui-button battle-ui-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="CharacterSelection" class="selection-screen" style="display: none;">
        <ui:Label text="SELEÇÃO DE PERSONAGEM" class="selection-title battle-ui-title" />
        <ui:VisualElement class="selection-carousel">
            <ui:Button name="PreviousCharacterButton" text="‹" class="selection-arrow battle-ui-button" />
            <ui:VisualElement name="CharacterPreview" class="selection-preview" picking-mode="Ignore" />
            <ui:Button name="NextCharacterButton" text="›" class="selection-arrow battle-ui-button" />
        </ui:VisualElement>
        <ui:Label name="CharacterName" text="MEISHO DOTO" class="selection-name" />
        <ui:Label name="CharacterIndex" text="1 / 25" class="selection-index" />
        <ui:ScrollView name="CharacterClassDetails" class="selection-class-details" horizontal-scroller-visibility="Hidden" style="display: none;">
            <ui:Label name="ClassNameLabel" class="selection-class-title" />
            <ui:VisualElement class="stat-grid">
                <ui:VisualElement class="stat-row">
                    <ui:Label text="VIDA" class="stat-name" />
                    <ui:VisualElement name="HealthStars" class="stat-stars" picking-mode="Position">
                        <ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star" /><ui:VisualElement class="stat-star" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="VELOCIDADE" class="stat-name" />
                    <ui:VisualElement name="SpeedStars" class="stat-stars" picking-mode="Position">
                        <ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star" /><ui:VisualElement class="stat-star" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="DANO" class="stat-name" />
                    <ui:VisualElement name="DamageStars" class="stat-stars" picking-mode="Position">
                        <ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star" /><ui:VisualElement class="stat-star" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="CADÊNCIA" class="stat-name" />
                    <ui:VisualElement name="CadenceStars" class="stat-stars" picking-mode="Position">
                        <ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star stat-star-filled" /><ui:VisualElement class="stat-star" /><ui:VisualElement class="stat-star" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="ClassAttributesLabel" class="selection-class-text" />
            <ui:Label name="ClassDescriptionLabel" class="selection-class-text" />
            <ui:Label name="PassiveDescriptionLabel" class="selection-class-text" />
            <ui:Label name="UltimateDescriptionLabel" class="selection-class-text" />
            <ui:Label name="ClassNoticeLabel" text="" class="selection-class-notice" />
        </ui:ScrollView>
        <ui:VisualElement class="selection-actions">
            <ui:Button name="CharacterBackButton" text="VOLTAR" class="selection-button selection-back battle-ui-button battle-ui-back" />
            <ui:Button name="ConfirmCharacterButton" text="COMEÇAR PARTIDA" class="selection-button battle-ui-button battle-ui-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
