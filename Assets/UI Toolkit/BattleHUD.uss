.battle-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-hud {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.hud-card {
    min-width: 200px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgba(16, 26, 46, 0.86);
    border-width: 2px;
    border-color: rgb(45, 65, 104);
    border-radius: 8px;
}

.score-card {
    align-items: flex-end;
}

.hud-caption {
    color: rgb(242, 201, 76);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-value {
    color: rgb(245, 245, 245);
    font-size: 27px;
    -unity-font-style: bold;
}

.health-track {
    width: 240px;
    height: 12px;
    margin-top: 7px;
    background-color: rgb(70, 35, 40);
    border-radius: 6px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(91, 205, 113);
    border-radius: 6px;
}

.defeat-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.87);
}

.defeat-card {
    width: 500px;
    max-width: 90%;
    padding-top: 45px;
    padding-bottom: 45px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgb(24, 36, 61);
    border-width: 2px;
    border-color: rgb(242, 201, 76);
    border-radius: 12px;
}

.defeat-title {
    color: rgb(242, 201, 76);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.defeat-score {
    margin-top: 18px;
    margin-bottom: 30px;
    color: rgb(245, 245, 245);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.defeat-button {
    width: 300px;
    height: 65px;
    background-color: rgb(242, 201, 76);
    color: rgb(16, 26, 46);
    border-width: 2px;
    border-color: rgb(242, 201, 76);
    font-size: 24px;
    -unity-font-style: bold;
}

.defeat-button:hover {
    background-color: rgb(255, 220, 110);
}

.match-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.match-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.match-countdown {
    width: 100%;
    color: rgb(255, 221, 110);
    font-size: 180px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(16, 26, 46);
}
