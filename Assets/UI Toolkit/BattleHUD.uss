@import url("BattleUITheme.uss");

.battle-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-hud {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    bottom: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.hud-card {
    min-width: 200px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgba(16, 26, 46, 0.86);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
}

.ultimate-card {
    position: absolute;
    right: 0;
    bottom: 0;
    flex-shrink: 0;
    width: 230px;
    padding: 12px;
    align-items: center;
    background-color: rgba(16, 26, 46, 0.9);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
}
.ultimate-name, .ultimate-status {
    color: var(--color-primary);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.ultimate-name { margin-bottom: 8px; font-size: 15px; }
.ultimate-status { margin-top: 8px; }
.ultimate-icon {
    width: 96px;
    height: 96px;
    overflow: hidden;
    background-color: rgb(109, 95, 176);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 2px;
    border-color: rgb(174, 168, 223);
    border-radius: 8px;
    opacity: 0.55;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}
.ultimate-placeholder {
    position: absolute;
    left: 0; right: 0; top: 10px; height: 42px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 16px;
    white-space: normal;
    color: white;
}
.ultimate-mask {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 0%;
    background-color: rgba(100, 213, 248, 0.45);
}
.ultimate-percent {
    position: absolute;
    left: 0; right: 0; bottom: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
    font-size: 19px;
    color: white;
}
.ultimate-ready { border-color: rgb(255, 220, 110); }
.ultimate-ready .ultimate-icon { border-color: rgb(255, 220, 110); border-width: 4px; opacity: 1; scale: 1.08 1.08; }
.ultimate-active .ultimate-icon { opacity: 1; }
.ultimate-active { border-color: rgb(91, 205, 113); }
.ultimate-unavailable { opacity: 0.6; }

.ultimate-screen-effect {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 10px;
    border-color: rgba(117, 229, 245, .2);
    background-color: rgba(70, 170, 195, .025);
}
.ultimate-screen-inner {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 18px;
    border-color: rgba(117, 229, 245, .045);
}

.objective-card {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
    align-items: center;
    min-width: 160px;
}

.result-title {
    font-size: 30px;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.hud-caption {
    color: var(--color-primary);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-value {
    color: var(--color-text);
    font-size: 27px;
    -unity-font-style: bold;
}

.health-track {
    width: 240px;
    height: 12px;
    margin-top: 7px;
    background-color: rgb(70, 35, 40);
    border-radius: 6px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: var(--battle-color-health);
    border-radius: 6px;
}

.defeat-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.35);
}

.defeat-card {
    width: 84%;
    max-width: 1100px;
    height: 88%;
    max-height: 860px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.92);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.result-time-caption {
    font-size: 26px;
    flex-shrink: 0;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.result-character-preview {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.result-body { width: 100%; flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.result-ranking { width: 48%; margin-left: 12px; padding: 8px; min-height: 0; }
.result-ranking-title { color: var(--color-primary); font-size: 18px; white-space: normal; }
.result-ranking-subtitle { color: var(--color-text); font-size: 13px; margin-bottom: 4px; }
.result-ranking-status { color: var(--color-text); font-size: 14px; white-space: normal; margin-bottom: 6px; }
.result-ranking-list {
    flex-grow: 1; min-height: 70px; font-size: 14px;
    background-color: rgba(16, 26, 46, 0.7);
    border-width: 1px; border-color: var(--color-border);
}
.result-ranking-list Label { color: var(--color-text); font-size: 14px; -unity-text-align: middle-center; }
.result-ranking-list .unity-multi-column-header,
.result-ranking-list .unity-multi-column-header-container,
.result-ranking-list .unity-multi-column-header__column { background-color: var(--color-panel); }
.result-ranking-list .unity-multi-column-header { min-height: 28px; height: 28px; }
.result-ranking-list .unity-list-view__item:hover,
.result-ranking-list .unity-list-view__item--selected { background-color: rgba(242, 201, 76, 0.18); }
.result-ranking-retry { height: 34px; font-size: 13px; margin-top: 4px; }
.result-actions { width: 100%; flex-direction: row; justify-content: center; flex-shrink: 0; flex-wrap: wrap; }
.result-actions .defeat-button { width: 31%; min-width: 140px; height: 52px; font-size: 18px; margin: 4px; }
.battle-compact .result-ranking-title { font-size: 15px; }
.battle-compact .result-ranking-status { font-size: 12px; }

.battle-compact .defeat-card {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
}
.battle-compact .result-title { font-size: 22px; margin-bottom: 4px; }
.battle-compact .result-time-caption { font-size: 18px; }
.battle-compact .result-time { font-size: 40px; margin-bottom: 4px; }
.battle-compact .result-duration { font-size: 15px; }
.battle-compact .save-status { font-size: 14px; margin-top: 4px; margin-bottom: 4px; }
.battle-compact .defeat-button {
    height: 42px;
    min-height: 42px;
    font-size: 16px;
    margin-top: 4px;
}

.result-time {
    margin-top: 0;
    margin-bottom: 12px;
    flex-shrink: 0;
    color: rgb(242, 201, 76);
    font-size: 64px;
    -unity-text-align: middle-center;
}

.result-duration, .save-status {
    color: var(--color-text);
    font-size: 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 12px;
    white-space: normal;
}

.objective-card { flex-direction: row; align-items: center; min-width: 0; padding-left: 12px; padding-right: 12px; }
.objective-stat { align-items: center; flex-shrink: 0; min-width: 115px; margin-left: 8px; margin-right: 8px; }
.objective-card .hud-caption { font-size: 14px; white-space: nowrap; }
.objective-card .hud-value { font-size: 28px; }
.result-top-ten { color: rgb(242, 201, 76); -unity-font-style: bold; }
.result-record { color: rgb(255, 221, 105); -unity-font-style: bold; font-size: 25px; padding: 6px; background-color: rgba(242, 201, 76, 0.12); border-radius: 6px; }
.battle-compact .result-record { font-size: 18px; }

.save-status {
    min-height: 28px;
    white-space: normal;
}

.defeat-button {
    width: 360px;
    max-width: 100%;
    height: 65px;
    flex-shrink: 0;
    font-size: 24px;
}

.match-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.6);
}

.pause-card {
    width: 560px;
    max-width: 90%;
    padding: 32px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.96);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.pause-title {
    font-size: 48px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
}

.pause-button {
    width: 100%;
    height: 65px;
    margin-top: 20px;
    font-size: 24px;
}

.pause-hint {
    margin-top: 16px;
    color: var(--color-text);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.pause-audio { width: 100%; margin-top: 12px; }
.pause-audio .slider-row { height: 38px; margin-top: 6px; margin-bottom: 6px; }
.pause-audio .slider-label { width: 82px; min-width: 0; font-size: 18px; }
.pause-audio .volume-slider { height: 32px; margin-left: 8px; margin-right: 8px; }
.pause-audio .slider-value-label { width: 50px; font-size: 16px; }

.match-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.match-countdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 180px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--color-background);
}
