@import url("BattleUITheme.uss");

.battle-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-hud {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.hud-card {
    min-width: 200px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgba(16, 26, 46, 0.86);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
}

.score-card {
    align-items: center;
    justify-content: center;
}

.score-card .hud-caption,
.score-card .hud-value {
    width: 100%;
    -unity-text-align: middle-center;
}

.score-card .hud-value {
    font-size: 40px;
}

.ultimate-card {
    position: absolute;
    right: 0;
    top: 100%;
    margin-top: 16px;
    width: 230px;
    padding: 12px;
    align-items: center;
    background-color: rgba(16, 26, 46, 0.9);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
}
.ultimate-name, .ultimate-status {
    color: var(--color-primary);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.ultimate-name { margin-bottom: 8px; }
.ultimate-status { margin-top: 8px; }
.ultimate-icon {
    width: 96px;
    height: 96px;
    overflow: hidden;
    background-color: rgb(109, 95, 176);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 2px;
    border-color: rgb(174, 168, 223);
    border-radius: 8px;
}
.ultimate-placeholder {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 32px;
    color: white;
}
.ultimate-mask {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 100%;
    background-color: rgba(5, 9, 20, 0.82);
}
.ultimate-percent {
    position: absolute;
    left: 0; right: 0; bottom: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
    font-size: 19px;
    color: white;
}
.ultimate-ready { border-color: rgb(255, 220, 110); }
.ultimate-ready .ultimate-icon { border-color: rgb(255, 220, 110); }
.ultimate-active { border-color: rgb(91, 205, 113); }
.ultimate-unavailable { opacity: 0.6; }

.ultimate-screen-effect {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 10px;
    border-color: rgba(117, 229, 245, .2);
    background-color: rgba(70, 170, 195, .025);
}
.ultimate-screen-inner {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 18px;
    border-color: rgba(117, 229, 245, .045);
}

.objective-card {
    align-items: center;
    min-width: 160px;
}

.result-title {
    font-size: 30px;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.hud-caption {
    color: var(--color-primary);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-value {
    color: var(--color-text);
    font-size: 27px;
    -unity-font-style: bold;
}

.health-track {
    width: 240px;
    height: 12px;
    margin-top: 7px;
    background-color: rgb(70, 35, 40);
    border-radius: 6px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: var(--battle-color-health);
    border-radius: 6px;
}

.defeat-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.35);
}

.defeat-card {
    width: 84%;
    max-width: 1100px;
    height: 88%;
    max-height: 860px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.92);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.result-score-caption {
    font-size: 26px;
    flex-shrink: 0;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.result-character-preview {
    width: 100%;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.battle-compact .defeat-card {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
}
.battle-compact .result-title { font-size: 22px; margin-bottom: 4px; }
.battle-compact .result-score-caption { font-size: 18px; }
.battle-compact .defeat-score { font-size: 40px; margin-bottom: 4px; }
.battle-compact .result-duration { font-size: 15px; }
.battle-compact .save-status { font-size: 14px; margin-top: 4px; margin-bottom: 4px; }
.battle-compact .defeat-button {
    height: 42px;
    min-height: 42px;
    font-size: 16px;
    margin-top: 4px;
}

.defeat-score {
    margin-top: 0;
    margin-bottom: 12px;
    flex-shrink: 0;
    color: rgb(242, 201, 76);
    font-size: 64px;
    -unity-text-align: middle-center;
}

.result-duration, .save-status {
    color: var(--color-text);
    font-size: 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.save-status {
    min-height: 28px;
    white-space: normal;
}

.defeat-button {
    width: 360px;
    max-width: 100%;
    height: 65px;
    flex-shrink: 0;
    font-size: 24px;
}

.match-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.6);
}

.pause-card {
    width: 560px;
    max-width: 90%;
    padding: 32px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.96);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.pause-title {
    font-size: 48px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
}

.pause-button {
    width: 100%;
    height: 65px;
    margin-top: 20px;
    font-size: 24px;
}

.pause-hint {
    margin-top: 16px;
    color: var(--color-text);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.pause-audio { width: 100%; margin-top: 12px; }
.pause-audio .slider-row { height: 38px; margin-top: 6px; margin-bottom: 6px; }
.pause-audio .slider-label { width: 82px; min-width: 0; font-size: 18px; }
.pause-audio .volume-slider { height: 32px; margin-left: 8px; margin-right: 8px; }
.pause-audio .slider-value-label { width: 50px; font-size: 16px; }

.match-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.match-countdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 180px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--color-background);
}
