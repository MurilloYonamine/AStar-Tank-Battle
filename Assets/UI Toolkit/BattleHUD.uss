@import url("BattleUITheme.uss");

.battle-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-hud {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.hud-card {
    min-width: 200px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgba(16, 26, 46, 0.86);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
}

.score-card {
    align-items: flex-end;
}

.hud-caption {
    color: var(--color-primary);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-value {
    color: var(--color-text);
    font-size: 27px;
    -unity-font-style: bold;
}

.health-track {
    width: 240px;
    height: 12px;
    margin-top: 7px;
    background-color: rgb(70, 35, 40);
    border-radius: 6px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: var(--battle-color-health);
    border-radius: 6px;
}

.defeat-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.35);
}

.defeat-card {
    width: 84%;
    max-width: 1100px;
    height: 88%;
    max-height: 860px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.92);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.result-score-caption {
    font-size: 26px;
    flex-shrink: 0;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.result-character-preview {
    width: 100%;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.defeat-score {
    margin-top: 0;
    margin-bottom: 12px;
    flex-shrink: 0;
    color: rgb(242, 201, 76);
    font-size: 64px;
    -unity-text-align: middle-center;
}

.defeat-button {
    width: 360px;
    max-width: 100%;
    height: 65px;
    flex-shrink: 0;
    font-size: 24px;
}

.match-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 25, 0.6);
}

.pause-card {
    width: 480px;
    max-width: 90%;
    padding: 32px;
    align-items: center;
    background-color: rgba(24, 36, 61, 0.96);
    border-width: 2px;
    border-color: var(--color-primary);
    border-radius: 12px;
}

.pause-title {
    font-size: 48px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
}

.pause-button {
    width: 100%;
    height: 65px;
    margin-top: 20px;
    font-size: 24px;
}

.pause-hint {
    margin-top: 16px;
    color: var(--color-text);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.match-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.match-countdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 180px;
    color: rgb(242, 201, 76);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--color-background);
}
