:root {
    --color-background: rgb(16, 26, 46);
    --color-panel: rgb(24, 36, 61);
    --color-border: rgb(45, 65, 104);
    --color-primary: rgb(242, 201, 76);
    --color-secondary: rgb(36, 59, 100);
    --color-text: rgb(245, 245, 245);
    --color-danger: rgb(180, 48, 48);
    --color-danger-border: rgb(230, 96, 96);
    --color-danger-hover: rgb(220, 72, 72);
    --color-danger-hover-border: rgb(255, 150, 150);
    --color-danger-active: rgb(130, 32, 32);
    --spacing-small: 10px;
    --spacing-medium: 20px;
    --spacing-large: 40px;
    -unity-font-definition: url("project://database/Assets/Fonts/Roboto-Regular.ttf?fileID=12800000&guid=e65daedc943aa864f8e731332c8d9027&type=3#Roboto-Regular");
}

#Background,
#ScoreScreen,
#PlayScreen,
#SettingsScreen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

#Background,
#ScoreScreen,
#PlayScreen,
#SettingsScreen {
    background-color: var(--color-background);
}

#GameTitle {
    position: absolute;
    left: 0;
    right: 0;
    top: 8%;
    color: var(--color-primary);
    font-size: 100px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-background);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.menu-button {
    background-color: var(--color-panel);
    border-color: var(--color-border);
    width: 42%;
    max-width: 450px;
    min-width: 260px;
    height: 100px;
    margin: var(--spacing-medium) 0;
    transition-property: scale;
    transition-duration: 0.1s;
}

.menu-button:hover {
    background-color: var(--color-primary);
    color: var(--color-background);
    scale: 1.05 1.05;
}

.menu-button:active {
    scale: 0.95 0.95;
}

.menu-button-text {
    font-size: 56px;
    color: var(--color-primary);
    -unity-font-style: bold;
}

#ButtonContainer {
    position: absolute;
    left: 0;
    right: 0;
    top: 27%;
    bottom: 5%;
    align-items: center;
    justify-content: center;
}

#ScoreTitle,
#PlayTitle,
.auth-title,
#LoginTitle,
#RegisterTitle,
#SettingsTitle {
    position: absolute;
    left: 0;
    right: 0;
    top: 8%;
    -unity-text-align: middle-center;
    color: var(--color-primary);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-background);
}

#ScoreTitle {
    font-size: 42px;
}

#PlayTitle,
.auth-title,
#LoginTitle,
#RegisterTitle,
#SettingsTitle {
    font-size: 72px;
}

#ScoreList {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 20%;
    bottom: 14%;
    min-height: 300px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--color-primary);
}

#ScoreList Label {
    color: var(--color-text);
    font-size: 22px;
    -unity-text-align: middle-center;
}

#ScoreList .unity-multi-column-row {
    min-height: 60px;
    background-color: var(--color-secondary);
}

#ScoreList .unity-multi-column-row:hover,
#ScoreList .unity-list-view__item:hover,
#ScoreList .unity-multi-column-list-view__item:hover,
#ScoreList .unity-list-view__item--selected {
    background-color: rgba(242, 201, 76, 0.22);
}

#ScoreList .unity-multi-column-header,
#ScoreList .unity-multi-column-header-container,
#ScoreList .unity-multi-column-header__column {
    background-color: var(--color-panel);
}

#ScoreList .unity-multi-column-header__column {
    justify-content: center;
    align-items: center;
}

#ScoreList .unity-multi-column-header__column__header-content {
    justify-content: center;
    align-items: center;
}

#ScoreList .unity-multi-column-header {
    color: var(--color-primary);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-height: 70px;
}

#BackButton,
#SettingsBackButton {
    position: absolute;
    width: 22%;
    max-width: 250px;
    min-width: 180px;
    height: 75px;
    left: 50%;
    bottom: 4%;
    translate: -50% 0;
    background-color: var(--color-panel);
    color: var(--color-primary);
    border-width: 2px;
    border-color: var(--color-border);
    -unity-font-style: bold;
    font-size: 32px;
    transition-property: scale;
    transition-duration: 0.1s;
}

#BackButton:hover,
#SettingsBackButton:hover {
    background-color: var(--color-secondary);
    color: var(--color-primary);
    border-color: var(--color-primary);
    scale: 1.05 1.05;
}

#BackButton:active,
#SettingsBackButton:active {
    background-color: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
    scale: 0.95 0.95;
}

.auth-section {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.auth-form {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 70%;
    max-width: 800px;
    min-width: 320px;
    translate: -50% -50%;
    flex-direction: column;
}

.auth-field {
    width: 100%;
    margin-bottom: 14px;
    flex-direction: column;
    --unity-cursor-color: var(--color-primary);
}

.auth-field .unity-base-field__label {
    width: 100%;
    margin-bottom: 6px;
    color: var(--color-text);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.auth-field .unity-base-field__input {
    width: 100%;
    min-height: 80px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--color-panel);
    color: var(--color-primary);
    --unity-cursor-color: var(--color-primary);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-top-color: var(--color-primary);
    border-right-color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-size: 52px;
}

.auth-field:hover .unity-base-field__input,
.auth-field:focus .unity-base-field__input {
    border-color: rgb(255, 230, 120);
    background-color: var(--color-secondary);
}

.auth-form .input-error {
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    max-width: none;
    translate: 0 0;
    min-height: 30px;
    margin-top: 6px;
    margin-bottom: 2px;
    color: rgb(255, 100, 100);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#PlayerNameField {
    position: absolute;
    left: 50%;
    right: auto;
    top: 48%;
    width: 70%;
    max-width: 800px;
    min-width: 300px;
    height: 130px;
    translate: -50% -50%;
    flex-direction: column;
    align-items: center;
    --unity-cursor-color: var(--color-primary);
}

#PlayerNameField .unity-base-field__label {
    width: 100%;
    margin-bottom: 8px;
    color: var(--color-text);
    font-size: 24px;
    -unity-text-align: middle-left;
}

#PlayerNameField .unity-base-field__input {
    width: 100%;
    min-height: 84px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--color-panel);
    color: var(--color-primary);
    --unity-cursor-color: var(--color-primary);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-top-color: var(--color-primary);
    border-right-color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-size: 64px;
}

#PlayerNameField:hover .unity-base-field__input,
#PlayerNameField:focus .unity-base-field__input {
    border-color: var(--color-primary);
}

.input-error {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 70%;
    max-width: 800px;
    translate: -50% 0;
    color: rgb(255, 100, 100);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#PlayButtonContainer,
#RegisterButtonContainer,
.auth-button-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6%;
    height: 90px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.play-screen-button {
    width: 22%;
    max-width: 240px;
    min-width: 140px;
    height: 80px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: var(--color-panel);
    color: var(--color-primary);
    border-width: 2px;
    border-color: var(--color-border);
    -unity-font-style: bold;
    font-size: 26px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.play-screen-button:hover {
    scale: 1.05 1.05;
}

.play-screen-button:active {
    scale: 0.95 0.95;
}

#StartButton,
#RegisterSubmitButton,
.primary-button {
    background-color: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
}

#StartButton:hover,
#RegisterSubmitButton:hover,
.primary-button:hover {
    background-color: rgb(255, 220, 110);
    color: var(--color-background);
    border-color: var(--color-primary);
}

#StartButton:active,
#RegisterSubmitButton:active,
.primary-button:active {
    background-color: rgb(210, 170, 40);
    color: var(--color-background);
    border-color: var(--color-primary);
}

#SkipLoginButton,
.skip-button {
    background-color: var(--color-secondary);
    color: var(--color-text);
    border-color: var(--color-border);
}

#SkipLoginButton:hover,
.skip-button:hover {
    background-color: rgb(48, 76, 126);
    color: rgb(255, 255, 255);
    border-color: rgb(100, 140, 200);
}

#SkipLoginButton:active,
.skip-button:active {
    background-color: var(--color-panel);
    color: var(--color-text);
}

#OpenRegisterButton,
.middle-button {
    background-color: var(--color-secondary);
    color: var(--color-primary);
    border-color: var(--color-primary);
}

#OpenRegisterButton:hover,
.middle-button:hover {
    background-color: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
}

#OpenRegisterButton:active,
.middle-button:active {
    background-color: rgb(210, 170, 40);
    color: var(--color-background);
    border-color: var(--color-primary);
}

#PlayBackButton,
#RegisterBackButton,
.back-button {
    background-color: var(--color-danger);
    color: var(--color-text);
    border-color: var(--color-danger-border);
}

#PlayBackButton:hover,
#RegisterBackButton:hover,
.back-button:hover {
    background-color: var(--color-danger-hover);
    color: var(--color-text);
    border-color: var(--color-danger-hover-border);
}

#PlayBackButton:active,
#RegisterBackButton:active,
.back-button:active {
    background-color: var(--color-danger-active);
    color: var(--color-text);
    border-color: var(--color-danger-border);
}

.settings-form {
    position: absolute;
    left: 50%;
    top: 48%;
    translate: -50% -50%;
    width: 65%;
    max-width: 800px;
    min-width: 320px;
    padding: 30px 40px;
    background-color: var(--color-panel);
    border-width: 2px;
    border-color: var(--color-border);
    flex-direction: column;
}

.slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    margin-bottom: 16px;
    height: 70px;
}

.slider-label {
    width: 170px;
    min-width: 130px;
    font-size: 32px;
    color: var(--color-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.volume-slider {
    flex-grow: 1;
    margin-left: 20px;
    margin-right: 20px;
    height: 48px;
    justify-content: center;
}

.volume-slider #unity-drag-container {
    justify-content: center;
}

.volume-slider #unity-tracker {
    height: 14px;
    background-color: var(--color-secondary);
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--color-border);
}

.volume-slider #unity-dragger {
    width: 32px;
    height: 32px;
    margin-top: -9px;
    background-color: var(--color-primary);
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--color-background);
    transition-property: scale;
    transition-duration: 0.1s;
}

.volume-slider #unity-dragger:hover {
    background-color: rgb(255, 230, 120);
    scale: 1.15 1.15;
}

.volume-slider #unity-dragger:active {
    background-color: rgb(210, 170, 40);
    scale: 0.95 0.95;
}

.slider-value-label {
    width: 90px;
    font-size: 28px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
