<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="BattleHUD.uss" />
    <ui:VisualElement name="BattleOverlay" class="battle-overlay" style="display: none;">
        <ui:VisualElement name="BattleHud" class="battle-hud">
            <ui:VisualElement class="hud-card">
                <ui:Label text="VIDA" class="hud-caption" />
                <ui:Label name="HealthLabel" text="100 / 100" class="hud-value" />
                <ui:VisualElement class="health-track">
                    <ui:VisualElement name="HealthFill" class="health-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-card objective-card">
              <ui:VisualElement class="objective-stat">
                <ui:Label text="TEMPO RESTANTE" class="hud-caption" />
                <ui:Label name="TimeLabel" text="03:00" class="hud-value" />
              </ui:VisualElement>
              <ui:VisualElement class="objective-stat">
                <ui:Label text="ELIMINAÇÕES" class="hud-caption" />
                <ui:Label name="EliminationLabel" text="0 / 10" class="hud-value" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="UltimateCard" class="ultimate-card">
                <ui:Label name="UltimateNameLabel" text="Unique Skill" class="ultimate-name" />
                <ui:VisualElement name="UltimateIcon" class="ultimate-icon" picking-mode="Ignore">
                    <ui:Label name="UltimatePlaceholder" text="Unique&#10;Skill" class="ultimate-placeholder" />
                    <ui:VisualElement name="UltimateMask" class="ultimate-mask" />
                </ui:VisualElement>
                <ui:Label name="UltimateStatusLabel" text="CARREGANDO" class="ultimate-status" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="UltimateScreenEffect" class="ultimate-screen-effect" picking-mode="Ignore" style="display: none;">
            <ui:VisualElement class="ultimate-screen-inner" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="DefeatScreen" class="defeat-screen">
            <ui:VisualElement class="defeat-card">
                <ui:Label name="ResultTitleLabel" text="RESULTADO" class="result-title battle-ui-title" />
                <ui:Label name="ResultTimeCaptionLabel" text="TEMPO DE CONCLUSÃO" class="result-time-caption" />
                <ui:Label name="FinalTimeLabel" text="00:00,000" class="result-time battle-ui-title" />
                <ui:Label name="ResultRankingNoteLabel" text="Apenas vitórias entram no ranking." class="result-duration" />
                <ui:Label name="ResultEliminationsLabel" text="ELIMINAÇÕES: 0 / 10" class="result-duration" />
                <ui:VisualElement class="result-body">
                    <ui:VisualElement name="ResultCharacterPreview" class="result-character-preview" picking-mode="Ignore" />
                    <ui:VisualElement name="ResultRankingPanel" class="result-ranking" style="display: none;">
                        <ui:Label text="RANKING" class="result-ranking-title" />
                        <ui:Label text="MELHORES TEMPOS" class="result-ranking-subtitle" />
                        <ui:Label name="ResultRankingStatusLabel" text="" class="result-ranking-status" />
                        <ui:MultiColumnListView name="ResultRankingList" class="result-ranking-list">
                            <ui:Columns>
                                <ui:Column name="Posicao" title="Pos." width="16%" />
                                <ui:Column name="Jogador" title="Jogador" width="50%" />
                                <ui:Column name="Tempo" title="Tempo" width="34%" />
                            </ui:Columns>
                        </ui:MultiColumnListView>
                        <ui:Button name="RetryRankingButton" text="RECARREGAR RANKING" class="battle-ui-button result-ranking-retry" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="SaveStatusLabel" text="" class="save-status" />
                <ui:Button name="RetrySaveButton" text="TENTAR SALVAR NOVAMENTE" class="defeat-button battle-ui-button" style="display: none;" />
                <ui:VisualElement class="result-actions">
                    <ui:Button name="ReplayButton" text="JOGAR NOVAMENTE" class="defeat-button battle-ui-button battle-ui-primary" />
                    <ui:Button name="ReturnToLoginButton" text="VOLTAR AO LOGIN" class="defeat-button battle-ui-button" />
                    <ui:Button name="ReturnToMenuButton" text="VOLTAR AO MENU" class="defeat-button battle-ui-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PauseScreen" class="pause-screen" style="display: none;">
            <ui:VisualElement class="pause-card">
                <ui:Label text="PAUSE" class="pause-title battle-ui-title" />
                <ui:VisualElement class="pause-audio">
                    <ui:VisualElement class="slider-row">
                        <ui:Label text="MASTER" class="slider-label" />
                        <ui:Slider name="PauseMasterSlider" low-value="0.0001" high-value="1" value="1" class="volume-slider" />
                        <ui:Label name="PauseMasterValueLabel" text="100%" class="slider-value-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="slider-row">
                        <ui:Label text="MÚSICA" class="slider-label" />
                        <ui:Slider name="PauseMusicSlider" low-value="0.0001" high-value="1" value="1" class="volume-slider" />
                        <ui:Label name="PauseMusicValueLabel" text="100%" class="slider-value-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="slider-row">
                        <ui:Label text="SFX" class="slider-label" />
                        <ui:Slider name="PauseSFXSlider" low-value="0.0001" high-value="1" value="1" class="volume-slider" />
                        <ui:Label name="PauseSFXValueLabel" text="100%" class="slider-value-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ResumeButton" text="CONTINUAR" class="pause-button battle-ui-button battle-ui-primary" />
                <ui:Label text="ESC para continuar" class="pause-hint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="MatchIntro" class="match-intro" style="display: none;">
        <ui:VisualElement name="MatchFade" class="match-fade" />
        <ui:Label name="CountdownLabel" text="1" class="match-countdown battle-ui-title" style="display: none;" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
